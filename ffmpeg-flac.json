{
    "name": "ffmpeg-flac",
    "description": "ffmpeg flac decoder",
    "filters":["rfflac","ffdec-flac"],
    "help": "This is a reduced version of ffmpeg adapted to decode flac content.",
    "support": [
        "audio"
    ],
    "sources":"https://bevara.ddns.net/sources/ffmpeg-flac.accessor",
    "filter_source":{
        "rfflac" : "reframe_flac.c",
        "ffdec-flac" : "ff_dec-flac.c"
    },
    "Format": ["FLAC"],
    "using": ["solver_1"],
    "runtime": {
        "ffdec-flac": {
            "outputs": [
                {
                    "property": "GF_PROP_PID_AUDIO_FORMAT",
                    "format": [
                        "GF_AUDIO_FMT_S16",
                        "GF_AUDIO_FMT_S16P",
                        "GF_AUDIO_FMT_S32",
                        "GF_AUDIO_FMT_S32P"
                    ]
                }
            ]
        }
    },
    "patents": {
        "status": "royalty-free",
        "note": "FLAC",
        "checked": "2026-10-16"
    }
}
